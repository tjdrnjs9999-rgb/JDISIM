{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "/api/payment-complete",
      "dest": "/api/payment-complete.js"
    },
    {
      "src": "/issue(\\.html)?",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate",
        "x-robots-tag": "index, follow",
        "x-frame-options": "DENY",
        "x-content-type-options": "nosniff"
      },
      "dest": "/issue.html"
    },
    {
      "src": "/(.*)\\.(png|jpg|jpeg|webp|gif|svg|ico|mp4|webm|woff|woff2|ttf|otf)",
      "headers": {
        "Cache-Control": "public, max-age=2592000",
        "x-robots-tag": "index, follow",
        "x-frame-options": "DENY",
        "x-content-type-options": "nosniff"
      },
      "dest": "/$1.$2"
    },
    {
      "src": "/(.*)\\.(js|css)",
      "headers": {
        "Cache-Control": "public, max-age=86400, stale-while-revalidate=604800",
        "x-robots-tag": "index, follow",
        "x-frame-options": "DENY",
        "x-content-type-options": "nosniff"
      },
      "dest": "/$1.$2"
    },
    {
      "src": "/(.*)",
      "headers": {
        "x-robots-tag": "index, follow",
        "x-frame-options": "DENY",
        "x-content-type-options": "nosniff"
      },
      "dest": "/$1"
    }
  ]
}